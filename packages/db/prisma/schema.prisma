// Jest(CJS環境)で import.meta エラーを回避するため moduleFormat = "cjs" を指定
generator client {
    provider     = "prisma-client"
    output       = "../generated"
    moduleFormat = "cjs"
}

// Data source
datasource db {
    provider = "postgresql"
}

// 設問ごとの回答と正誤（提出時点の正誤を固定して保存する）。selected_choice_index の CHECK 制約は Drizzle 側にある
model AttemptAnswer {
    id                  Int      @id @default(autoincrement())
    attemptId           Int      @map("attempt_id")
    questionId          Int      @map("question_id")
    /// NULL は未回答
    selectedChoiceIndex Int?     @map("selected_choice_index") @db.SmallInt
    isCorrect           Boolean  @map("is_correct")
    createdAt           DateTime @default(now()) @map("created_at")
    updatedAt           DateTime @updatedAt @map("updated_at")

    attempt  ReadingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
    question Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)

    @@unique([attemptId, questionId])
    @@map("attempt_answers")
}

// 調べた単語。source は @repo/domain の定数から作る CHECK 制約があるが、Prisma では表現できないので String にしている
// （Prisma 実装の Repository は isWordLookupSource で検証してから domain 型にする）
model AttemptWordLookup {
    id              Int      @id @default(autoincrement())
    attemptId       Int      @map("attempt_id")
    userId          Int      @map("user_id")
    passageId       Int      @map("passage_id")
    /// 本文中の表記
    surface         String
    /// 見出し語
    lemma           String
    /// WORD_LOOKUP_SOURCES
    source          String
    /// 用語集から引いた場合だけ
    glossaryEntryId Int?     @map("glossary_entry_id")
    createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @updatedAt @map("updated_at")

    attempt       ReadingAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
    user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    passage       Passage               @relation(fields: [passageId], references: [id], onDelete: Restrict)
    glossaryEntry PassageGlossaryEntry? @relation(fields: [glossaryEntryId], references: [id], onDelete: SetNull)

    @@index([userId, lemma])
    @@index([attemptId])
    @@map("attempt_word_lookups")
}

// 認証アカウント（複数プロバイダー対応、 (provider, providerAccountId) で一意）
// OAuth プロバイダの access_token / refresh_token 等は本アプリでは保持しない
// （プロバイダ側で発行・管理し、アプリは取得した user info を DB に保存後は内部 JWT で完結する）
model AuthAccount {
    id                Int      @id @default(autoincrement())
    userId            Int      @map("user_id")
    /// "google" | "github" | "credentials" など
    provider          String
    /// プロバイダー側のユーザー ID
    providerAccountId String   @map("provider_account_id")
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId])
    @@map("auth_accounts")
}

// 英文の取得元（ソース）。取得方法（fetch_type）ごとの列は nullable で、必須は Drizzle 側の CHECK 制約で保証する
// kind / fetch_type / license_spdx は @repo/domain の定数から作る CHECK 制約があるが、Prisma では表現できないので String にしている
// （Prisma 実装の Repository は isSourceKind / isSourceFetchType / isAllowedLicense で検証してから domain 型にする）
model ContentSource {
    id                     Int       @id @default(autoincrement())
    name                   String
    /// SOURCE_KINDS
    kind                   String
    /// SOURCE_FETCH_TYPES
    fetchType              String    @map("fetch_type")
    /// string[]
    includeGlobs           Json      @map("include_globs")
    /// string[]
    excludeGlobs           Json      @default("[]") @map("exclude_globs")
    /// ALLOWED_LICENSES
    licenseSpdx            String    @map("license_spdx")
    licenseUrl             String    @map("license_url")
    /// string[]
    tags                   Json      @default("[]")
    isEnabled              Boolean   @default(false) @map("is_enabled")
    lastCollectedAt        DateTime? @map("last_collected_at")
    /// GitHub のみ。owner/name
    repository             String?   @unique
    /// GitHub のみ
    branch                 String?
    /// GitHub のみ
    publicUrlTemplate      String?   @map("public_url_template")
    /// GitHub のみ
    publicUrlStripPrefix   String?   @map("public_url_strip_prefix")
    /// GitHub のみ
    lastCollectedCommitSha String?   @map("last_collected_commit_sha")
    /// サイトのみ。オリジン
    siteUrl                String?   @unique @map("site_url")
    /// サイトのみ
    sitemapUrl             String?   @map("sitemap_url")
    /// サイトのみ
    startUrl               String?   @map("start_url")
    /// サイトのみ
    contentSelector        String?   @map("content_selector")
    /// サイトのみ。string[]
    excludeSelectors       Json      @default("[]") @map("exclude_selectors")
    createdAt              DateTime  @default(now()) @map("created_at")
    updatedAt              DateTime  @updatedAt @map("updated_at")

    documents SourceDocument[]

    @@map("content_sources")
}

// 英和辞書（EJDict-hand）。headword を小文字に限る CHECK 制約は Drizzle 側にある
model DictionaryEntry {
    id        Int      @id @default(autoincrement())
    /// 見出し語（小文字）
    headword  String   @unique
    meaningJa String   @map("meaning_ja")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("dictionary_entries")
}

// メモ
model Memo {
    id        Int      @id @default(autoincrement())
    title     String   @db.VarChar(255)
    body      String   @db.Text
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("memos")
}

// 本文候補 / 問題。状態（status）で収集から公開までを表す。物理削除しない
// status / difficulty は @repo/domain の定数から作る CHECK 制約があるが、Prisma では表現できないので String / Int にしている
// （Prisma 実装の Repository は isPassageStatus / isPassageDifficulty で検証してから domain 型にする）
model Passage {
    id                      Int       @id @default(autoincrement())
    sourceDocumentId        Int       @map("source_document_id")
    /// 取得時のファイルパス or URL のパス
    sourcePath              String    @map("source_path")
    /// 取得時のコミット。GitHub のみ
    sourceCommitSha         String?   @map("source_commit_sha")
    sourceRetrievedAt       DateTime  @map("source_retrieved_at")
    /// PASSAGE_STATUSES
    status                  String    @default("collected")
    title                   String
    /// PassageBlock[]
    blocks                  Json
    wordCount               Int       @map("word_count")
    contentHash             String    @unique @map("content_hash")
    /// PASSAGE_DIFFICULTIES
    difficulty              Int?      @db.SmallInt
    timeLimitSeconds        Int?      @map("time_limit_seconds")
    generationAttemptCount  Int       @default(0) @map("generation_attempt_count")
    generationStartedAt     DateTime? @map("generation_started_at")
    generationError         String?   @map("generation_error")
    generationModel         String?   @map("generation_model")
    generationPromptVersion String?   @map("generation_prompt_version")
    generatedAt             DateTime? @map("generated_at")
    needsAttention          Boolean   @default(false) @map("needs_attention")
    /// string[]
    attentionReasons        Json      @default("[]") @map("attention_reasons")
    rejectReason            String?   @map("reject_reason")
    reviewedAt              DateTime? @map("reviewed_at")
    publishedAt             DateTime? @map("published_at")
    createdAt               DateTime  @default(now()) @map("created_at")
    updatedAt               DateTime  @updatedAt @map("updated_at")

    sourceDocument  SourceDocument         @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
    questions       Question[]
    glossaryEntries PassageGlossaryEntry[]
    readingAttempts ReadingAttempt[]
    wordLookups     AttemptWordLookup[]
    audio           PassageAudio?
    audioUsages     AudioSynthesisUsage[]

    @@index([status, createdAt])
    @@index([sourceDocumentId])
    @@map("passages")
}

// 問題ごとの読み上げの音声（read-aloud）。1 問 1 行。CHECK 制約は Drizzle のマイグレーションが正本
// status は @repo/domain の AUDIO_STATUSES から作る CHECK 制約があるが、Prisma では表現できないので String にしている
// （Prisma 実装の Repository は isAudioStatus で検証してから domain 型にする）
model PassageAudio {
    id                    Int       @id @default(autoincrement())
    passageId             Int       @unique @map("passage_id")
    /// AUDIO_STATUSES
    status                String    @default("pending")
    voiceId               String    @map("voice_id")
    /// 読み上げ対象の本文と voice のハッシュ
    textHash              String    @map("text_hash")
    /// PassageAudioManifest
    manifest              Json?
    /// Polly の課金文字数（音声 + 単語の時刻）
    billedCharacters      Int       @default(0) @map("billed_characters")
    attemptCount          Int       @default(0) @map("attempt_count") @db.SmallInt
    lastError             String?   @map("last_error")
    /// 生成タスクが確保した時刻（確保のトークン）。generating の行と、ready のまま確保した行が値を持つ
    generationStartedAt   DateTime? @map("generation_started_at")
    generatedAt           DateTime? @map("generated_at")
    /// admin が「作り直す」を押した時刻（作り直しの依頼）
    regenerateRequestedAt DateTime? @map("regenerate_requested_at")
    createdAt             DateTime  @default(now()) @map("created_at")
    updatedAt             DateTime  @updatedAt @map("updated_at")

    passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([status])
    @@map("passage_audios")
}

// 読み上げの音声合成（Amazon Polly の SynthesizeSpeech）で課金された文字数の記録（read-aloud）。追記だけ。
// generate:audio が今月（UTC の暦月）の合計で AUDIO_MONTHLY_CHARACTER_LIMIT を超えないようにする。CHECK 制約は Drizzle のマイグレーションが正本
model AudioSynthesisUsage {
    id         Int      @id @default(autoincrement())
    passageId  Int      @map("passage_id")
    /// 課金された文字数（Polly の RequestCharacters）
    characters Int
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    passage Passage @relation(fields: [passageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@index([createdAt])
    @@map("audio_synthesis_usages")
}

// 用語集（本文中の難しい単語・熟語と、この文脈での意味）
// 位置は blocks[blockIndex].text（バッククォートを含む生の文字列）上の UTF-16 の index で [startOffset, endOffset)。
// offset の CHECK 制約は Drizzle 側にある
model PassageGlossaryEntry {
    id           Int      @id @default(autoincrement())
    passageId    Int      @map("passage_id")
    blockIndex   Int      @map("block_index")
    startOffset  Int      @map("start_offset")
    /// end は含まない
    endOffset    Int      @map("end_offset")
    /// 本文中の表記
    surface      String
    /// 見出し語
    lemma        String
    /// 文脈での意味
    meaningJa    String   @map("meaning_ja")
    partOfSpeech String?  @map("part_of_speech")
    noteJa       String?  @map("note_ja")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    passage     Passage             @relation(fields: [passageId], references: [id], onDelete: Cascade)
    targetedBy  Question[]          @relation("QuestionTarget")
    wordLookups AttemptWordLookup[]

    @@index([passageId])
    @@index([lemma])
    @@map("passage_glossary_entries")
}

// 設問。type は @repo/domain の定数から作る CHECK 制約があるが、Prisma では表現できないので String にしている
// （Prisma 実装の Repository は isQuestionType で検証してから domain 型にする）。correct_choice_index などの CHECK 制約も Drizzle 側にある
model Question {
    id                      Int      @id @default(autoincrement())
    passageId               Int      @map("passage_id")
    orderIndex              Int      @map("order_index") @db.SmallInt
    /// QUESTION_TYPES
    type                    String
    prompt                  String
    /// string[]（4 つ。表示順のまま）
    choices                 Json
    correctChoiceIndex      Int      @map("correct_choice_index") @db.SmallInt
    explanationJa           String   @map("explanation_ja")
    evidenceBlockIndex      Int      @map("evidence_block_index")
    evidenceQuote           String   @map("evidence_quote")
    /// vocabulary のときだけ
    targetGlossaryEntryId   Int?     @map("target_glossary_entry_id")
    /// 解答キーを見ない検証で検証モデルが選んだ選択肢
    verificationChoiceIndex Int?     @map("verification_choice_index") @db.SmallInt
    createdAt               DateTime @default(now()) @map("created_at")
    updatedAt               DateTime @updatedAt @map("updated_at")

    passage             Passage               @relation(fields: [passageId], references: [id], onDelete: Cascade)
    targetGlossaryEntry PassageGlossaryEntry? @relation("QuestionTarget", fields: [targetGlossaryEntryId], references: [id], onDelete: SetNull)
    answers             AttemptAnswer[]

    @@unique([passageId, orderIndex])
    @@map("questions")
}

// 挑戦。status は @repo/domain の定数から作る CHECK 制約があるが、Prisma では表現できないので String にしている
// （Prisma 実装の Repository は isAttemptStatus で検証してから domain 型にする）。
// 部分 unique index（(user_id, passage_id) WHERE status = 'in_progress'）と submitted の列の CHECK 制約は Drizzle のマイグレーションが正本で、Prisma では表現しない
model ReadingAttempt {
    id                   Int       @id @default(autoincrement())
    userId               Int       @map("user_id")
    passageId            Int       @map("passage_id")
    /// ATTEMPT_STATUSES
    status               String    @default("in_progress")
    startedAt            DateTime  @map("started_at")
    submittedAt          DateTime? @map("submitted_at")
    /// 開始時点の制限時間
    timeLimitSeconds     Int       @map("time_limit_seconds")
    elapsedSeconds       Int?      @map("elapsed_seconds")
    isOvertime           Boolean?  @map("is_overtime")
    questionCount        Int?      @map("question_count") @db.SmallInt
    correctCount         Int?      @map("correct_count") @db.SmallInt
    translatedBlockCount Int       @default(0) @map("translated_block_count") @db.SmallInt
    /// 解答中に読み上げを聞いた段落の数
    listenedBlockCount   Int       @default(0) @map("listened_block_count") @db.SmallInt
    wordLookupCount      Int       @default(0) @map("word_lookup_count") @db.SmallInt
    /// 提出時のユーザーの TZ での日付。Prisma では UTC の 0 時の Date で返るので、Repository で toISOString().slice(0, 10) にする
    studyDate            DateTime? @map("study_date") @db.Date
    createdAt            DateTime  @default(now()) @map("created_at")
    updatedAt            DateTime  @updatedAt @map("updated_at")

    user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    passage     Passage             @relation(fields: [passageId], references: [id], onDelete: Restrict)
    answers     AttemptAnswer[]
    wordLookups AttemptWordLookup[]

    @@index([userId, studyDate])
    @@index([userId, passageId])
    @@map("reading_attempts")
}

// 学習リマインダーの設定（1 ユーザー 1 行。docs/spec/study-reminder）。
// weekdays の値域と time の 15 分刻みは API の Zod で検証する（DB に制約は無い）。既定値は DB に持たせない
model ReminderSetting {
    id        Int      @id @default(autoincrement())
    userId    Int      @unique @map("user_id")
    isEnabled Boolean  @map("is_enabled")
    /// ISO の曜日番号（1 = 月曜 〜 7 = 日曜）の配列。Prisma では Json で返るので、Repository で検証してから domain 型にする
    weekdays  Json
    /// 端末の時刻（15 分刻み）。Prisma では 1970-01-01 の UTC の DateTime として読み書きされるので、Repository で "HH:mm" と変換する
    time      DateTime @db.Time(0)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("reminder_settings")
}

// 取得した文書（GitHub のファイル / サイトのページ）。取得方法ごとの列は nullable
model SourceDocument {
    id             Int       @id @default(autoincrement())
    sourceId       Int       @map("source_id")
    /// GitHub はリポジトリ内のファイルパス、サイトは URL のパス
    path           String
    title          String?
    /// NULL は未取得
    fetchedAt      DateTime? @map("fetched_at")
    contentHash    String?   @map("content_hash")
    /// GitHub のみ
    blobSha        String?   @map("blob_sha")
    /// GitHub のみ
    commitSha      String?   @map("commit_sha")
    /// サイトのみ
    etag           String?
    /// サイトのみ。Last-Modified ヘッダの値
    lastModified   String?   @map("last_modified")
    /// サイトのみ
    sitemapLastmod DateTime? @map("sitemap_lastmod")
    /// サイトのみ
    httpStatus     Int?      @map("http_status") @db.SmallInt
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")

    source   ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
    passages Passage[]

    @@unique([sourceId, path])
    @@index([sourceId, fetchedAt])
    @@map("source_documents")
}

// ユーザー（認証プロバイダー非依存）
model User {
    id        Int      @id @default(autoincrement())
    email     String?  @unique
    name      String?
    avatarUrl String?  @map("avatar_url")
    /// IANA タイムゾーン名（例: Asia/Tokyo）。値の検証は API の入力時に行う
    timezone  String   @default("Asia/Tokyo")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    accounts        AuthAccount[]
    goal            UserGoal?
    readingAttempts ReadingAttempt[]
    reminderSetting ReminderSetting?
    wordLookups     AttemptWordLookup[]

    @@map("users")
}

// ユーザーの目標（1 ユーザー 1 行）。weekly_metric は @repo/domain の定数から作る CHECK 制約があるが、Prisma では表現できないので String にしている
// （Prisma 実装の Repository は isGoalMetric で検証してから domain 型にする）。weekly_target の CHECK 制約も Drizzle のマイグレーションが持つ
model UserGoal {
    id           Int       @id @default(autoincrement())
    userId       Int       @unique @map("user_id")
    goalText     String?   @map("goal_text") @db.VarChar(200)
    /// Prisma では UTC の 0 時の Date で返るので、Repository で toISOString().slice(0, 10) にする
    targetDate   DateTime? @map("target_date") @db.Date
    /// GOAL_METRICS
    weeklyMetric String?   @map("weekly_metric")
    weeklyTarget Int?      @map("weekly_target")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("user_goals")
}
