# ==============================================================================
# migration 専用イメージ (Drizzle / ClickHouse)
# ==============================================================================
# 本番 API イメージに drizzle-kit / devDependencies を混ぜないため、migration は
# 独立した最小イメージにする。ECS で `aws ecs run-task` により one-shot 起動され、
# migration を実行して終了する (Service ではない)。
#
# - Drizzle (Postgres): CMD の既定。schema / migrations / config は packages/db (@repo/db)
# - ClickHouse: packages/data-warehouse/clickhouse (@repo/data-warehouse)。ECR リポジトリを増やさないため
#   同じイメージに同梱し、タスク定義の command で `pnpm --filter @repo/data-warehouse dwh:migrate:run` を起動する
#   (設計: docs/spec/clickhouse-migration/README.md)
#
# turbo prune で 2 つの workspace に必要なものだけを抽出する。
# drizzle-kit / clickhouse-migrations / tsx は devDependency なので --prod にせず全 install する。

# ==============================================================================
# Stage 1: base - pnpm をインストールしたベースイメージ
# ==============================================================================
FROM node:20-slim AS base

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# ==============================================================================
# Stage 2: pruner - @repo/db / @repo/data-warehouse に必要な workspace を抽出
# ==============================================================================
FROM base AS pruner

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages

RUN npx -y turbo@2.6.1 prune @repo/db @repo/data-warehouse --docker

# ==============================================================================
# Stage 3: runner - drizzle-kit / ClickHouse の migration コマンドと定義を持ち migrate を実行
# ==============================================================================
FROM base AS runner

# tini: ECS Fargate では docker --init が使えないため軽量 init として必須。
RUN apt-get update \
  && apt-get install -y --no-install-recommends tini ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# package.json + lock を先に入れて install (drizzle-kit / clickhouse-migrations は devDep なので --prod にしない)
COPY --from=pruner /app/out/json/ ./
RUN pnpm install --frozen-lockfile

# drizzle.config.ts / migrations / schema (src/drizzle)、ClickHouse の migrations / views を含むソースをコピー
COPY --from=pruner /app/out/full/ ./

# ClickHouse の migration コマンドが import する workspace パッケージ (@repo/logger) は dist/ を読むためビルドする
RUN pnpm turbo run build --filter=@repo/data-warehouse^...

# CDC の対象一覧。turbo prune は workspace 外のファイルを含めないため個別にコピーする
COPY infra/clickhouse/cdc-tables.json ./infra/clickhouse/cdc-tables.json

ENTRYPOINT ["/usr/bin/tini", "--"]

# DATABASE_URL は ECS task definition の secrets で注入される。
# db:migrate = `drizzle-kit migrate --config=drizzle/drizzle.config.ts` (packages/db で実行)
CMD ["pnpm", "--filter", "@repo/db", "db:migrate"]
