{
  "name": "cron",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "cleanup:old-memos": "dotenvx run -f .env.local -- tsx src/task/cleanup-old-memos.ts",
    "collect:passages": "dotenvx run -f .env.local -- tsx src/task/collect-passages.ts",
    "dev": "dotenvx run -f .env.local -- tsx watch src/index.ts",
    "generate:audio": "dotenvx run -f .env.local -- tsx src/task/generate-audio.ts",
    "generate:questions": "dotenvx run -f .env.local -- tsx src/task/generate-questions.ts",
    "generate:word-audio": "dotenvx run -f .env.local -- tsx src/task/generate-word-audio.ts",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "start": "dotenvx run -f .env.local -- node dist/index.js",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-polly": "^3.1075.0",
    "@repo/content-extractor": "workspace:^",
    "@repo/db": "workspace:^",
    "@repo/domain": "workspace:^",
    "@repo/errors": "workspace:^",
    "@repo/logger": "workspace:^",
    "@repo/storage": "workspace:^",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
